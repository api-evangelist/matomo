      "item": [
        {
          "id": "cf657d9b-f688-4c20-b969-08856f707bcc",
          "name": "Submit a single tracking request (querystring)",
          "request": {
            "name": "Submit a single tracking request (querystring)",
            "description": {
              "content": "Records a single pageview, event, content interaction, search, or\necommerce action by passing tracking parameters in the URL\nquerystring. `idsite` and `rec=1` are required.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "matomo.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "idsite",
                  "value": "<integer>",
                  "description": "(Required) ID of the website being tracked."
                },
                {
                  "disabled": false,
                  "key": "rec",
                  "value": "<integer>",
                  "description": "(Required) Must be set to 1 to record the request."
                },
                {
                  "disabled": false,
                  "key": "action_name",
                  "value": "<string>",
                  "description": "Title of the action being tracked (page title)."
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "Full URL for the current action."
                },
                {
                  "disabled": false,
                  "key": "_id",
                  "value": "<string>",
                  "description": "16 character unique visitor ID (hex)."
                },
                {
                  "disabled": false,
                  "key": "rand",
                  "value": "<string>",
                  "description": "Random value to avoid intermediary caching."
                },
                {
                  "disabled": false,
                  "key": "apiv",
                  "value": "<integer>",
                  "description": "API version, currently 1."
                },
                {
                  "disabled": false,
                  "key": "urlref",
                  "value": "<uri>",
                  "description": "Full HTTP Referrer URL."
                },
                {
                  "disabled": false,
                  "key": "res",
                  "value": "<string>",
                  "description": "Screen resolution, e.g. 1280x1024."
                },
                {
                  "disabled": false,
                  "key": "cookie",
                  "value": "<integer>",
                  "description": "Whether the visitor's browser supports cookies."
                },
                {
                  "disabled": false,
                  "key": "ua",
                  "value": "<string>",
                  "description": "Override the User-Agent HTTP header."
                },
                {
                  "disabled": false,
                  "key": "uadata",
                  "value": "<string>",
                  "description": "JSON-encoded Client Hints."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Accept-Language HTTP header override."
                },
                {
                  "disabled": false,
                  "key": "uid",
                  "value": "<string>",
                  "description": "User ID string for the logged-in user."
                },
                {
                  "disabled": false,
                  "key": "cid",
                  "value": "<string>",
                  "description": "16 character visitor ID override (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "new_visit",
                  "value": "<integer>",
                  "description": "Force a new visit to be created for this action."
                },
                {
                  "disabled": false,
                  "key": "link",
                  "value": "<uri>",
                  "description": "External URL clicked by the user (outlink)."
                },
                {
                  "disabled": false,
                  "key": "download",
                  "value": "<uri>",
                  "description": "URL of a downloaded file."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Site search query."
                },
                {
                  "disabled": false,
                  "key": "search_cat",
                  "value": "<string>",
                  "description": "Specified search category."
                },
                {
                  "disabled": false,
                  "key": "search_count",
                  "value": "<integer>",
                  "description": "Number of search results displayed."
                },
                {
                  "disabled": false,
                  "key": "pv_id",
                  "value": "<string>",
                  "description": "6 character unique ID for the pageview."
                },
                {
                  "disabled": false,
                  "key": "idgoal",
                  "value": "<integer>",
                  "description": "Goal ID for conversion tracking."
                },
                {
                  "disabled": false,
                  "key": "revenue",
                  "value": "<number>",
                  "description": "Monetary value generated as revenue."
                },
                {
                  "disabled": false,
                  "key": "ec_id",
                  "value": "<string>",
                  "description": "Unique String identifier for the ecommerce order."
                },
                {
                  "disabled": false,
                  "key": "e_c",
                  "value": "<string>",
                  "description": "Event category."
                },
                {
                  "disabled": false,
                  "key": "e_a",
                  "value": "<string>",
                  "description": "Event action."
                },
                {
                  "disabled": false,
                  "key": "e_n",
                  "value": "<string>",
                  "description": "Event name."
                },
                {
                  "disabled": false,
                  "key": "e_v",
                  "value": "<number>",
                  "description": "Event numeric value."
                },
                {
                  "disabled": false,
                  "key": "c_n",
                  "value": "<string>",
                  "description": "Name of the content block."
                },
                {
                  "disabled": false,
                  "key": "c_p",
                  "value": "<string>",
                  "description": "Actual content piece (text or media URL)."
                },
                {
                  "disabled": false,
                  "key": "c_t",
                  "value": "<string>",
                  "description": "Target of the content interaction (URL)."
                },
                {
                  "disabled": false,
                  "key": "c_i",
                  "value": "<string>",
                  "description": "Type of content interaction (e.g. click)."
                },
                {
                  "disabled": false,
                  "key": "ec_id",
                  "value": "<string>",
                  "description": "Unique string identifier for the ecommerce order."
                },
                {
                  "disabled": false,
                  "key": "ec_items",
                  "value": "<string>",
                  "description": "JSON-encoded array of ecommerce line items."
                },
                {
                  "disabled": false,
                  "key": "ec_st",
                  "value": "<number>",
                  "description": "Sub-total of the order, excluding shipping."
                },
                {
                  "disabled": false,
                  "key": "ec_tx",
                  "value": "<number>",
                  "description": "Tax amount of the order."
                },
                {
                  "disabled": false,
                  "key": "ec_sh",
                  "value": "<number>",
                  "description": "Shipping cost of the order."
                },
                {
                  "disabled": false,
                  "key": "ec_dt",
                  "value": "<number>",
                  "description": "Discount offered on the order."
                },
                {
                  "disabled": false,
                  "key": "token_auth",
                  "value": "<string>",
                  "description": "Auth token. Required for parameters that override server-side\nvalues (cip, cdt > 24h, country/region/city/lat/long, cid).\n"
                },
                {
                  "disabled": false,
                  "key": "cip",
                  "value": "<string>",
                  "description": "Override the visitor IP (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "cdt",
                  "value": "<string>",
                  "description": "Override datetime of the request (UTC, requires token_auth if older than 24h)."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Override visitor country code (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Override visitor region code (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "Override visitor city (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<number>",
                  "description": "Override visitor latitude (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "long",
                  "value": "<number>",
                  "description": "Override visitor longitude (requires token_auth)."
                },
                {
                  "disabled": false,
                  "key": "send_image",
                  "value": "<integer>",
                  "description": "If 0, return HTTP 204 instead of the 1x1 GIF."
                },
                {
                  "disabled": false,
                  "key": "ping",
                  "value": "<integer>",
                  "description": "Heartbeat ping; updates total_time on an existing visit."
                },
                {
                  "disabled": false,
                  "key": "queuedtracking",
                  "value": "<integer>",
                  "description": "Bypass the Queued Tracking plugin for this request."
                },
                {
                  "disabled": false,
                  "key": "bots",
                  "value": "<integer>",
                  "description": "Set to 1 to record requests from known bots."
                }
              ],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{matomo_host}}",
                  "key": "matomo_host"
