  "info": {
    "_postman_id": "2fccef66-7722-4aee-a07f-a2aeaf13ce48",
    "name": "Matomo Reporting API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Programmatic access to Matomo analytics reports. All Reporting API calls\nare dispatched through a single `/index.php` entrypoint by supplying\n`module=API` and a `method=Module.MethodName` query parameter. The API\nexposes 200+ methods across modules like VisitsSummary, Actions,\nReferrers, UserCountry, DevicesDetection, and Goals.\n\n\nContact Support:\n Name: Matomo Developer Documentation",
      "type": "text/plain"
    }
  }
