                },
                {
                  "key": "method",
                  "value": "<string>"
                },
                {
                  "key": "idSite",
                  "value": "<string>"
                },
                {
                  "key": "period",
                  "value": "<string>"
                },
                {
                  "key": "date",
                  "value": "<string>"
                },
                {
                  "key": "format",
                  "value": "xml"
                },
                {
                  "key": "segment",
                  "value": "<string>"
                },
                {
                  "key": "token_auth",
                  "value": "<string>"
                },
                {
                  "key": "token_auth",
                  "value": "<API Key>"
                }
              ],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{matomo_host}}",
                  "key": "matomo_host"
                }
              ]
            },
            "method": "GET",
            "body": {}
