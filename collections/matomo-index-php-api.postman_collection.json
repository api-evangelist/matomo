          "request": {
            "name": "Invoke a Matomo Reporting API method",
            "description": {
              "content": "All Matomo Reporting API methods are invoked via this single\nendpoint by passing `module=API` and the `method` parameter\n(for example `VisitsSummary.get` or `Actions.getPageUrls`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "index.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "module",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "method",
                  "value": "<string>",
                  "description": "(Required) `Module.MethodName`, for example `VisitsSummary.get`,\n`Actions.getPageUrls`, `Referrers.getKeywords`,\n`UserCountry.getCountry`, `API.getBulkRequest`.\n"
                },
                {
                  "disabled": false,
                  "key": "idSite",
                  "value": "<string>",
                  "description": "Site ID (or comma-separated list / `all`)."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Date in YYYY-MM-DD or magic keywords (today, yesterday, lastWeek)."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "xml"
                },
                {
                  "disabled": false,
                  "key": "segment",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "token_auth",
                  "value": "<string>",
                  "description": "Matomo auth token. Prefer passing in POST body for security.\n"
