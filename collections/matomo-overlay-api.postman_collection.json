                  "value": "<string>"
                },
                {
                  "description": "Custom segment to filter the report. Example: \"referrerName==example.com\" Supports AND (;) and OR (,) operators.",
                  "key": "segment",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns the following pages reached after visits to a specific page URL."
