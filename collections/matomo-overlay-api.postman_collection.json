        {
          "name": "Overlay get following pages",
          "id": "05ac6309-da27-4754-8d70-535af8f414d3",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/index.php?module=API&method=Overlay.getFollowingPages&format=xml&url=<string>&idSite=<integer>&period=range&date=<string>&segment=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "index.php"
              ],
              "query": [
                {
                  "key": "module",
                  "value": "API"
                },
                {
                  "key": "method",
                  "value": "Overlay.getFollowingPages"
                },
                {
                  "description": "Response format. Defaults to `xml`. Use `original` to get the original PHP data structure.",
                  "key": "format",
                  "value": "xml"
                },
                {
                  "description": "(Required) Page URL to analyze.",
                  "key": "url",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The numeric ID of the website to query.",
                  "key": "idSite",
                  "value": "<integer>"
                },
                {
                  "description": "(Required) The period to process, processes data for the period containing the specified date.",
                  "key": "period",
                  "value": "range"
                },
                {
                  "description": "(Required) The date or date range to process. 'YYYY-MM-DD', magic keywords (today, yesterday, lastWeek, lastMonth, lastYear), or date range (ie, 'YYYY-MM-DD,YYYY-MM-DD', lastX, previousX).",
