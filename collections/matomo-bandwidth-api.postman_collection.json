                },
                {
                  "description": "Response format. Defaults to `xml`. Use `original` to get the original PHP data structure.",
                  "key": "format",
                  "value": "xml"
                },
                {
                  "description": "(Required) Website ID(s) to query. - Single site ID (e.g. 1) - Multiple site IDs (e.g. [1, 4, 5]) - Comma-separated list (\"1,4,5\") or \"all\"",
                  "key": "idSite",
                  "value": "<integer>"
                },
                {
                  "description": "(Required) The period to process, processes data for the period containing the specified date.",
                  "key": "period",
                  "value": "week"
                },
                {
                  "description": "(Required) The date or date range to process. 'YYYY-MM-DD', magic keywords (today, yesterday, lastWeek, lastMonth, lastYear), or date range (ie, 'YYYY-MM-DD,YYYY-MM-DD', lastX, previousX).",
                  "key": "date",
                  "value": "<string>"
                },
                {
                  "description": "Custom segment to filter the report. Example: \"referrerName==example.com\" Supports AND (;) and OR (,) operators.",
                  "key": "segment",
                  "value": "<string>"
                },
                {
                  "description": "Metric columns to return. Accepts a comma-separated list, an array of metric names, or false to return all available bandwidth metrics.",
                  "key": "columns",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns aggregated bandwidth metrics for the requested site selection and archive period."
