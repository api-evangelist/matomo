        "description": {
          "content": "POST may carry the same parameters as GET in a form-encoded body,\nor a JSON body containing a `requests` array for Bulk Tracking.\nBulk tracking can include hundreds of requests in one HTTP call;\nrequests should be sent in chronological order.\n",
          "type": "text/plain"
        },
        "url": {
